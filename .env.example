# Optional additions. Retain all existing Supabase and authentication variables.
# Alternatively, configure the final website origin in Admin > Site Settings.
SITE_URL=

# Optional Resend delivery. Configure a sender on your verified domain.
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=
# Optional fixed recipient overrides the team email saved in Forms settings.
ENQUIRY_EMAIL_TO=

# Optional Google reporting: choose OAuth or a server service account.
# All these values are server-only; never prefix them with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Generate 32 random bytes as hex with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Alternative: the complete service account JSON, stored as a protected server setting.
GOOGLE_SERVICE_ACCOUNT_JSON=

# v9 booking: a dedicated Calendar service account; share your team calendar with it.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
# v9 encrypted application + media backups. Keep this stable and protect an offline copy.
CMS_BACKUP_ENCRYPTION_KEY=
# At least 32 random characters; match this in your maintenance scheduler.
CRON_SECRET=
